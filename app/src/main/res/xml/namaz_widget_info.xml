<?xml version="1.0" encoding="utf-8"?>
<!--
    Widget description.

    resizeMode lets it be dragged to any size; the code hides rows that no
    longer fit rather than letting them clip. minResizeHeight is set low
    enough that a one-row strip showing just the prayer and its countdown is a
    legitimate size, because that is all some people want on a home screen.

    targetCellWidth/Height, maxResize* and previewLayout are Android 12 and
    up. Older versions ignore attributes they do not recognise, so they cost
    nothing and give a proper preview on newer phones.

    updatePeriodMillis is a backstop, not the mechanism: Android clamps it to
    30 minutes anyway. The countdown ticks by itself because it is a
    Chronometer, and the widget is refreshed properly at each prayer boundary
    by an alarm the app schedules — see NamazWidget.scheduleNextRefresh.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:minWidth="250dp"
    android:minHeight="110dp"
    android:minResizeWidth="180dp"
    android:minResizeHeight="60dp"
    android:maxResizeWidth="400dp"
    android:maxResizeHeight="280dp"
    android:targetCellWidth="4"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:updatePeriodMillis="1800000"
    android:initialLayout="@layout/widget_namaz"
    android:previewLayout="@layout/widget_namaz"
    android:previewImage="@mipmap/ic_launcher"
    android:description="@string/widget_description" />
