<?xml version="1.0" encoding="utf-8"?>
<!--
    The home-screen widget.

    One layout for every size rather than several. The widget is resizable, so
    the code measures how much room it actually has and hides the rows that
    will not fit — see NamazWidget.render. Shipping separate layouts per size
    would mean keeping four files in step for no visible gain.

    Only the views RemoteViews understands are used here: LinearLayout,
    TextView, ImageView and Chronometer. ConstraintLayout and friends are not
    allowed in a widget and fail at inflation time, not at compile time.

    The countdown is a Chronometer, not a TextView the app keeps rewriting.
    Android ticks a Chronometer itself, once a second, with no alarm and no
    wakeup of this app at all — which is the difference between a live
    countdown and one that would need a wakeup every minute to stay honest.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- Prayer name, and whether it is marked -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/w_prayer"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:textSize="19sp"
            android:textStyle="bold"
            android:textColor="@color/w_gold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="@string/app_name" />

        <TextView
            android:id="@+id/w_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/w_muted"
            android:text="" />
    </LinearLayout>

    <!-- Starts at, and when it becomes qaza -->
    <TextView
        android:id="@+id/w_window"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="11sp"
        android:textColor="@color/w_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <TextView
        android:id="@+id/w_hijri"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:textSize="10sp"
        android:textColor="@color/w_muted"
        android:maxLines="1"
        android:ellipsize="end"
        android:text="" />

    <!-- Live countdown, ticked by the system rather than by this app -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="bottom"
        android:layout_marginTop="5dp">

        <Chronometer
            android:id="@+id/w_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="26sp"
            android:textStyle="bold"
            android:textColor="@color/w_green" />

        <TextView
            android:id="@+id/w_left_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:layout_marginBottom="4dp"
            android:textSize="11sp"
            android:textColor="@color/w_muted"
            android:text="" />
    </LinearLayout>

    <!-- Today's five, the count, and the streak -->
    <LinearLayout
        android:id="@+id/w_stats"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="9dp">

        <ImageView
            android:id="@+id/w_dot1"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />

        <ImageView
            android:id="@+id/w_dot2"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />

        <ImageView
            android:id="@+id/w_dot3"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />

        <ImageView
            android:id="@+id/w_dot4"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="4dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />

        <ImageView
            android:id="@+id/w_dot5"
            android:layout_width="9dp"
            android:layout_height="9dp"
            android:layout_marginEnd="9dp"
            android:contentDescription="@null"
            android:src="@drawable/widget_dot_off" />

        <TextView
            android:id="@+id/w_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:textColor="@color/w_muted"
            android:maxLines="1"
            android:text="" />

        <TextView
            android:id="@+id/w_streak"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:textSize="11sp"
            android:textStyle="bold"
            android:textColor="@color/w_gold"
            android:maxLines="1"
            android:ellipsize="end"
            android:text="" />
    </LinearLayout>

    <!-- Mark it prayed without opening the app -->
    <TextView
        android:id="@+id/w_mark"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="9dp"
        android:background="@drawable/widget_button"
        android:gravity="center"
        android:paddingTop="9dp"
        android:paddingBottom="9dp"
        android:textSize="12sp"
        android:textStyle="bold"
        android:textColor="@color/w_ink"
        android:text="" />
</LinearLayout>
